{
  "name": "rest-mapper",
  "version": "2.0.0",
  "description": "A typed, isomorphic REST mapper for browsers and Node.js with axios, fetch, and undici transports.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:compat": "node scripts/compatibility-smoke.mjs",
    "lint:pack": "publint && attw --pack .",
    "verify": "npm run typecheck && npm run test:coverage && npm run build && npm run lint:pack && npm run test:compat",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cezarsmpio/rest-mapper.git"
  },
  "keywords": [
    "rest",
    "mapper",
    "restful",
    "typescript",
    "javascript",
    "client",
    "ajax",
    "axios",
    "fetch",
    "undici"
  ],
  "author": "Cezar Sampaio <cezarsmpio@gmail.com> (https://github.com/cezarsmpio)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cezarsmpio/rest-mapper/issues"
  },
  "homepage": "https://github.com/cezarsmpio/rest-mapper#readme",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "axios": ">=1.0.0 <2.0.0",
    "undici": ">=6.0.0 <9.0.0"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": true
    },
    "undici": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "axios": "1.21.1",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "undici": "8.12.4",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
